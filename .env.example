# Cloud web deployment
# Production must use the external HTTPS origin without a path.
# For local development, set APP_ORIGIN=http://localhost:3000.
APP_ORIGIN=https://notes.example.com
DATABASE_URL=postgres://veil:veil_password@localhost:5432/veil_notes
DATABASE_POOL_SIZE=10

# Set DATABASE_SSL=require for managed PostgreSQL providers that require TLS.
DATABASE_SSL=disable

# Production defaults to closed registration. Create the first account with:
# VEIL_ADMIN_USERNAME=admin VEIL_ADMIN_PASSWORD='change-this-password' pnpm run user:create
VEIL_ALLOW_REGISTRATION=false
VEIL_SEED_SAMPLE_NOTES=false
VEIL_AUTH_LOCKOUT_FAILURES=10
VEIL_AUTH_LOCKOUT_WINDOW_MINUTES=15
VEIL_AUTH_LOCKOUT_DURATION_MINUTES=15

# Uploaded note images. Keep VEIL_UPLOAD_DIR on persistent storage in production.
# Production requires an absolute path.
VEIL_UPLOAD_DIR=/var/lib/veil-notes/uploads
VEIL_MAX_UPLOAD_BYTES=10485760
VEIL_ASSET_QUOTA_BYTES=1073741824
VEIL_ORPHAN_ASSET_GRACE_DAYS=7

# docker-compose uses this for the bundled PostgreSQL service.
POSTGRES_PASSWORD=change-this-postgres-password

# Optional. Desktop/Tauri/Electron can use this as a default vault path.
VEIL_LOCAL_VAULT_PATH=
