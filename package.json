{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:app": "node scripts/dev-app.cjs",
    "env:check": "node scripts/check-env.mjs",
    "migrate": "node scripts/migrate.mjs",
    "assets:cleanup": "node scripts/cleanup-assets.mjs",
    "db:check": "node scripts/db-integration-check.mjs",
    "smoke:cloud": "node scripts/cloud-smoke.mjs",
    "build": "next build --webpack",
    "build:cloud": "NODE_ENV=production pnpm run env:check && pnpm run migrate && next build --webpack",
    "start": "next start",
    "standalone:prepare": "node scripts/prepare-standalone.cjs",
    "start:cloud": "pnpm run env:check && pnpm run migrate && pnpm run standalone:prepare && node .next/standalone/server.js",
    "start:standalone": "pnpm run start:cloud",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy:check": "pnpm run lint && pnpm run test && npx tsc --noEmit && pnpm run build && pnpm run standalone:prepare",
    "user:create": "node scripts/create-user.mjs",
    "password:reset": "node scripts/reset-password.mjs",
    "app:dev": "NEXT_PUBLIC_APP_RUNTIME=desktop electron .",
    "app:prepare": "node scripts/prepare-electron.cjs",
    "app:build": "pnpm run build && pnpm run app:prepare && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "app:build:signed": "pnpm run build && pnpm run app:prepare && electron-builder --mac dir"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "ogl": "^1.0.11",
    "pg": "^8.21.0",
    "react": "^19",
    "react-dom": "^19",
    "sanitize-html": "^2.17.4",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "electron": "^31.7.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.veil.notes",
    "productName": "Veil Notes",
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**",
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      ".next/standalone/**",
      ".next/static/**",
      "public/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "sharp",
      "unrs-resolver"
    ]
  }
}
